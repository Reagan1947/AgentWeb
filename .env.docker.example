# Copy to .env for `docker compose`.

# Interface for the direct ports (3001 and Steel's 3000). Keep 127.0.0.1 and use HTTPS below to expose them.
BIND_ADDRESS=127.0.0.1
# The address your browser uses for Steel's live view.
STEEL_DOMAIN=localhost:3000
STEEL_USE_SSL=false
AGENTWEB_PORT=3001

# Host folder mounted at /workspace. It must be writable by AGENT_UID (`id -u` on this host).
WORKSPACE_DIR=./workspace
AGENT_UID=1000

# Extra tools built into the image, comma-separated: jdk8,jdk17 (each adds Maven).
# Other tools are listed in docker/extra-tools.sh. Rebuild after changing this.
OPTIONAL_TOOLS=

# Optional: Claude can also sign in with `claude login` in the Shell tab.
# ANTHROPIC_API_KEY=

# HTTPS with a public domain. Point the domain and steel.<domain> at this machine and open 80 and 443.
# COMPOSE_PROFILES=https
# PUBLIC_DOMAIN=example.com
# STEEL_DOMAIN=steel.example.com
# STEEL_USE_SSL=true
